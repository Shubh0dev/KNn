# Copy to .env.local (git-ignored) and fill in values from
# Supabase Dashboard -> Project Settings -> API Keys.

# Public (safe in the browser; access is limited by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical origin used in auth email links and OAuth redirects, no trailing slash.
# e.g. http://localhost:3000 locally, https://your-domain in production.
NEXT_PUBLIC_SITE_URL=

# "Continue with Google" appears automatically once the Google provider is
# enabled in Supabase Dashboard -> Authentication -> Sign In / Providers.

# Optional: only when serving from a sub-folder.
# BASE_PATH=

# Server-only secret. NOT used in Part 1. Never prefix with NEXT_PUBLIC_,
# never import it into client code, and only use it in trusted server code
# such as payment webhooks.
# SUPABASE_SECRET_KEY=
